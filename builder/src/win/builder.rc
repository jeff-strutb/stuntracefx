/* builder.rc: the Windows builder's resources: icon, manifest and version.
 * payload.h (written by builder/build.sh) carries the version, and
 * builder.ico (the game's icon, icon/icons.sh) is beside it. */
#include <windows.h>
#include "payload.h"

1 ICON "builder.ico"
1 RT_MANIFEST "builder.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RB_VER_MAJOR, RB_VER_MINOR, 0, 0
PRODUCTVERSION  RB_VER_MAJOR, RB_VER_MINOR, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Strut B, LLC"
      VALUE "FileDescription", "Stunt Race FX Builder"
      VALUE "ProductName", "Stunt Race FX Builder"
      VALUE "FileVersion", RB_VERSION_STR
      VALUE "ProductVersion", RB_VERSION_STR
      VALUE "InternalName", "StuntRaceFXBuilder"
      VALUE "OriginalFilename", "StuntRaceFXBuilder.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
