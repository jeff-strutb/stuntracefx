/* ocean.shade: the sea as facets (fx/fx_ground.c, "the ocean"). uv is the
   pixel's place on the screen less the water's origin; inputs 0-7 are the
   projective map from it to the pixel's place on the water in lattice
   cells (u along the world's x, v along its z, the eye's place taken modulo
   the lattice's pattern):
     u = (i0 x + i1 y + i2) / (i6 x + i7 y + 1), v = (i3 x + i4 y + i5) / (same).
   The water's vertices carry no depth divisor, so its depth is exactly the
   3D's own and the shapes drawn after it (the road, what is above the
   water) cover it as they are meant to.

   The water is a lattice of square cells, each cut on one of its diagonals
   (which, by a hash of the cell) into two triangles. Each lattice point
   rises and falls on two waves of its own phase (periods 2.5 s and 4 s), and
   each triangle is one flat facet, coloured as the chip colours a lit face:
   its level, floor(its normal . k), kept to 6-15, picks that level's colour
   of the shade row. Where a cell is smaller than about a pixel the facets
   give way to the flat sea's colour, as there they could only flicker.
   Partly see-through: the more steeply the eye looks down on the water the
   more of what lies under it shows; toward the horizon it is whole. Seen
   from below (the eye under the water) it is whole.

   The image (RGBA, a word a texel): texels 0-9 the shade row's colours at
   levels 6-15, 10 the flat sea's colour; from 11 floats: k (3, the light by
   the level's scale, in the world's axes, y down), the time in seconds
   (within 600, whole periods of both waves), the eye's place in cells (2),
   the eye's height over the water in cells (below 0 under it), the waves'
   height in cells. */
const int N = 64;                   /* the lattice's pattern repeats every N cells (fx_ground.c's OCEAN_PERIOD) */
const float ALPHA_NEAR = 0.6;       /* how much the water covers seen straight down */
const int H = 11;                   /* the floats' first texel */

uint word_at(int i) {
    uvec4 b = uvec4(nshvc_image(ivec2(i, 0)) * 255.0 + 0.5);
    return b.a << 24 | b.r << 16 | b.g << 8 | b.b;
}

float header(int i) { return uintBitsToFloat(word_at(H + i)); }

uint hash(ivec2 p, uint salt) {
    uvec2 q = uvec2(p & (N - 1));
    uint h = q.x * 0x9E3779B9u ^ q.y * 0x85EBCA6Bu ^ salt;
    h ^= h >> 15;
    h *= 0x2C1B3C6Du;
    h ^= h >> 12;
    h *= 0x297A2D39u;
    h ^= h >> 15;
    return h;
}

float height(ivec2 p, float t, float a) {
    uint h = hash(p, 0u);
    float ph1 = float(h & 1023u) * (6.2831853 / 1024.0);
    float ph2 = float((h >> 10) & 1023u) * (6.2831853 / 1024.0);
    return a * (sin(t * 2.5132741 + ph1) + 0.5 * sin(t * 1.5707963 + ph2));
}

vec4 shade(vec2 xy) {
    float den = nshvc_input(6) * xy.x + nshvc_input(7) * xy.y + 1.0;
    if (den <= 0.0)
        return vec4(0.0);
    vec2 uv = vec2(nshvc_input(0) * xy.x + nshvc_input(1) * xy.y + nshvc_input(2),
                   nshvc_input(3) * xy.x + nshvc_input(4) * xy.y + nshvc_input(5)) / den;
    vec3 k = vec3(header(0), header(1), header(2));
    float t = header(3), a = header(7);
    ivec2 c = ivec2(floor(uv));
    vec2 f = uv - vec2(c);
    ivec2 o0, o1, o2;

    /* the cell's triangle under the pixel: its diagonal from (0,0) to (1,1)
       or from (1,0) to (0,1) */
    if ((hash(c, 0x5BD1E995u) & 1u) == 0u) {
        o0 = ivec2(0, 0);
        o1 = f.x > f.y ? ivec2(1, 0) : ivec2(1, 1);
        o2 = f.x > f.y ? ivec2(1, 1) : ivec2(0, 1);
    } else {
        o0 = ivec2(1, 0);
        o1 = f.x + f.y < 1.0 ? ivec2(0, 0) : ivec2(1, 1);
        o2 = ivec2(0, 1);
    }
    vec3 p0 = vec3(vec2(o0), 0.0).xzy + vec3(0.0, height(c + o0, t, a), 0.0);
    vec3 p1 = vec3(vec2(o1), 0.0).xzy + vec3(0.0, height(c + o1, t, a), 0.0);
    vec3 p2 = vec3(vec2(o2), 0.0).xzy + vec3(0.0, height(c + o2, t, a), 0.0);
    /* its normal facing up (here y is up), then in the world's axes (y down) */
    vec3 n = cross(p1 - p0, p2 - p0);
    if (n.y < 0.0)
        n = -n;
    n = normalize(vec3(n.x, -n.y, n.z));
    float level = clamp(floor(dot(n, k)), 6.0, 15.0);
    vec3 colour = nshvc_image(ivec2(int(level) - 6, 0)).rgb;
    /* far off, the flat sea */
    vec2 fw = fwidth(uv);
    float fade = smoothstep(0.3, 0.9, max(fw.x, fw.y));
    colour = mix(colour, nshvc_image(ivec2(10, 0)).rgb, fade);
    /* how much it covers: by how steeply the eye looks down on it */
    float dh = abs(header(6));
    vec2 d = uv - vec2(header(4), header(5));
    float steep = dh / sqrt(dh * dh + dot(d, d));
    float alpha = header(6) < 0.0 ? 1.0 : mix(ALPHA_NEAR, 1.0, pow(1.0 - steep, 4.0));
    return vec4(colour, max(alpha, fade));
}
