#version 450
/*
 * widen.comp: the picture's indices (fullwindow.c's texels, bytes) as the canvas's
 * 32-bit texels for the hand-off (nshvc_handoff.h): 0 transparent, 1 colour 1,
 * 0x000000ii an index. A thread a pixel.
 */
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint px[]; };
layout(std430, binding = 11) writeonly buffer Out32 { uint o32[]; };
layout(push_constant) uniform Push { uint n; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n)
        o32[i] = (px[i >> 2] >> ((i & 3u) * 8u)) & 255u;
}
