#version 450
/*
 * fill.comp: the spans to the texels, a thread a row's 32 columns, each
 * row's spans in their order (fw_span_fill_cpu's rules, the Metal
 * kernel's): a flat span its colour, a textured one its texel through
 * COLOR's and PLOT's rules. The texels are bytes, four a word: a thread's
 * 32 columns are 8 whole words, read once and written once.
 */
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Out { uint px[]; };
layout(std430, binding = 1) readonly buffer Spans { uint sp[]; };
layout(std430, binding = 2) readonly buffer RowAt { uint row_at[]; };
layout(std430, binding = 3) readonly buffer RowSpans { uint row_spans[]; };
layout(std430, binding = 4) readonly buffer Banks { uint banks[]; };
layout(std430, binding = 5) readonly buffer Slot { int slot[]; };
layout(push_constant) uniform Push { uint w; uint h; uint pad0; uint pad1; vec4 water; } pc;

/* fullwindow.c's sunk: the water nearer than the span on this pixel's ray */
bool sunk(float za, float zx, float zy, int x, int y)
{
    precise float z = fma(zy, float(y), fma(zx, float(x), za));
    precise float w = fma(pc.water.z, float(y), fma(pc.water.y, float(x), pc.water.x));
    return z > 0.0 && w > 0.0 && z < w;
}

uint persp_texel(float a, float q)
{
    precise float t = div_ieee(a, q);
    if (!(t > -1.0e9 && t < 1.0e9))
        t = 0.0;
    return uint(int(floor(t))) & 255u;
}

int texel_colour(uint v, uint por, uint hi)
{
    uint c = (por & 4u) != 0u ? (hi | (v >> 4)) : (por & 8u) != 0u ? (hi | (v & 15u)) : v;
    c &= 255u;
    if ((por & 1u) == 0u) {
        if ((por & 8u) != 0u) {
            if ((c & 15u) == 0u)
                return -1;
        } else if (c == 0u) {
            return -1;
        }
    }
    return int(c);
}

uint bank_byte(int s, uint at)
{
    uint a = uint(s) * 65536u + (at & 0xFFFFu);
    return (banks[a >> 2] >> ((a & 3u) * 8u)) & 255u;
}

void main()
{
    uint gx = gl_GlobalInvocationID.x, gy = gl_GlobalInvocationID.y;
    if (gy >= pc.h)
        return;
    int c0 = int(gx) * 32, c1 = c0 + 31;
    if (c0 >= int(pc.w))
        return;
    if (c1 >= int(pc.w))
        c1 = int(pc.w) - 1;
    uint word0 = (gy * pc.w + uint(c0)) >> 2, words = (uint(c1 - c0) >> 2) + 1u;
    uint o[8];
    for (uint k = 0u; k < 8u; k++)
        o[k] = k < words ? px[word0 + k] : 0u;
    for (uint i = row_at[gy]; i < row_at[gy + 1u]; i++) {
        uint b = row_spans[i] * SPAN_WORDS;
        int x0 = int(sp[b + 1]), x1 = int(sp[b + 2]);
        int a = max(x0, c0), e = min(x1, c1);
        if (a > e)
            continue;
        uint textured = sp[b + 16] & 255u;
        uint colour = sp[b + 15] >> 24;
        float za = uintBitsToFloat(sp[b + 24]), zx = uintBitsToFloat(sp[b + 25]), zy = uintBitsToFloat(sp[b + 26]);
        bool deep = pc.water.w != 0.0 && (za != 0.0 || zx != 0.0 || zy != 0.0);
        int sy = int(sp[b]);
        if (textured == 0u) {
            for (int x = a; x <= e; x++) {
                if (deep && sunk(za, zx, zy, x, sy))
                    continue;
                uint j = uint(x - c0);
                o[j >> 2] = (o[j >> 2] & ~(255u << ((j & 3u) * 8u))) | (colour << ((j & 3u) * 8u));
            }
            continue;
        }
        int64_t xl = i64(sp[b + 4], sp[b + 5]);
        uint base = sp[b + 14] & 0xFFFFu, mask = sp[b + 14] >> 16;
        uint bank = sp[b + 15] & 255u, por = (sp[b + 15] >> 8) & 255u, hi = (sp[b + 15] >> 16) & 255u;
        int s = slot[bank];
        if (textured == 2u) {
            float pq = uintBitsToFloat(sp[b + 18]), pdq = uintBitsToFloat(sp[b + 19]);
            float pa = uintBitsToFloat(sp[b + 20]), pda = uintBitsToFloat(sp[b + 21]);
            float pb = uintBitsToFloat(sp[b + 22]), pdb = uintBitsToFloat(sp[b + 23]);
            for (int x = a; x <= e; x++) {
                precise float k = float(x - int(xl));
                precise float q = fma(pdq, k, pq);
                uint iu = persp_texel(fma(pda, k, pa), q), iv = persp_texel(fma(pdb, k, pb), q);
                int c = texel_colour(bank_byte(s, ((((iv << 8) | iu) & mask) + base) & 0xFFFFu), por, hi);
                if (c >= 0 && !(deep && sunk(za, zx, zy, x, sy))) {
                    uint j = uint(x - c0);
                    o[j >> 2] = (o[j >> 2] & ~(255u << ((j & 3u) * 8u))) | (uint(c) << ((j & 3u) * 8u));
                }
            }
            continue;
        }
        int64_t u = i64(sp[b + 6], sp[b + 7]), du = i64(sp[b + 8], sp[b + 9]);
        int64_t v = i64(sp[b + 10], sp[b + 11]), dv = i64(sp[b + 12], sp[b + 13]);
        for (int x = a; x <= e; x++) {
            int64_t k = int64_t(x) - xl;
            uint iu = uint((u + du * k) >> 32) & 255u, iv = uint((v + dv * k) >> 32) & 255u;
            int c = texel_colour(bank_byte(s, ((((iv << 8) | iu) & mask) + base) & 0xFFFFu), por, hi);
            if (c >= 0 && !(deep && sunk(za, zx, zy, x, sy))) {
                uint j = uint(x - c0);
                o[j >> 2] = (o[j >> 2] & ~(255u << ((j & 3u) * 8u))) | (uint(c) << ((j & 3u) * 8u));
            }
        }
    }
    for (uint k = 0u; k < 8u; k++)
        if (k < words)
            px[word0 + k] = o[k];
}
